# NOXEnOS Plank Dock Configuration
# Optimized for smooth parabolic magnification and macOS workflow

[PlankDockPreferences]
# Active theme
Theme=NOXEnOS-DarkGlass
# Dock position (0=Left, 1=Right, 2=Top, 3=Bottom)
Position=3
# Alignment (0=Auto, 1=Start, 2=End, 3=Center)
Alignment=3
# Offset from screen edge in pixels
Offset=0
# Base icon size in pixels
IconSize=56
# Smooth zoom / magnification on mouse hover
ZoomEnabled=true
# Zoom scale percent (150% = 1.5x zoom)
ZoomPercent=150
# Auto-hide behavior: 1 = Intelligent Auto-Hide (hides when windows overlap)
HideMode=1
# Delay in ms before unhiding
UnhideDelay=0
# Delay in ms before hiding
HideDelay=250
# Automatically pin applications dragged into dock
AutoPinning=true
# Lock items to prevent accidental drag-out
LockItems=false
# Pressure reveal for touch/pen
PressureReveal=false
# Hide the plank dock configuration icon
ShowDockItem=false
# Item glow color
ItemStrokeColor=0;;210;;255;;180
